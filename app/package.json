{
  "name": "devops-tarefas-api",
  "version": "1.0.0",
  "description": "API de tarefas usada na Atividade Avaliativa DevOps na Prática (CI/CD, Kubernetes, Helm e Elastic Stack)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "LOG_FILE=./logs/app.log node src/server.js",
    "test": "jest --coverage"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "elastic-apm-node": "4.11.0",
    "express": "4.21.2"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "supertest": "7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "lines": 80
      }
    }
  }
}
